DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Supabase session pooler (port 5432), not the transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Blazor WASM dev origins
CORS_ALLOWED_ORIGINS=https://localhost:7000,http://localhost:5000
