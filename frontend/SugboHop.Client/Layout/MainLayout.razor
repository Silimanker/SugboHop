@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav

<div class="app-shell">
    <header class="site-header">
        <nav class="site-nav" aria-label="Main navigation">
            <a class="brand-mark" href="" aria-label="SugboHop home">
                <span class="brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 32 32" fill="none"><path d="M4 20c4.3 0 4.3-3 8.6-3s4.3 3 8.6 3 4.3-3 8.6-3M4 25c4.3 0 4.3-3 8.6-3s4.3 3 8.6 3 4.3-3 8.6-3" stroke="currentColor" stroke-linecap="round" stroke-width="2.5"/><path d="M16 4c-4 4.1-4 7.4 0 10.2C20 11.4 20 8.1 16 4Z" fill="currentColor"/></svg>
                </span>
                <span>Sugbo<span>Hop</span></span>
            </a>
            <div class="nav-links">
                <a href="#islands-heading" class="nav-discover">Discover</a>
                <AuthorizeView>
                    <Authorized>
                        <a href="profile" class="nav-profile">My trips</a>
                        <button type="button" @onclick="LogoutAsync" class="nav-login">Log out</button>
                    </Authorized>
                    <NotAuthorized>
                        <a href="login" class="nav-login">Log in</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </nav>
    </header>
    @Body
    <footer class="site-footer">
        <a class="footer-brand" href="">SugboHop</a>
        <span>Made for slow days and salt air.</span>
        <span class="footer-region">CENTRAL VISAYAS · PHILIPPINES</span>
    </footer>
</div>

@code {
    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("");
    }
}
