@page "/"
@inject CatalogService Catalog

<PageTitle>SugboHop - Dashboard</PageTitle>

<div class="max-w-7xl mx-auto p-6">
    <h1 class="font-heading text-3xl font-bold mb-4">Featured Central Visayas Islands</h1>

    @if (error is not null)
    {
        <div class="rounded-2xl border border-sugbo-sunrise bg-sugbo-sunrise/10 p-4 text-sm">
            <p>@error</p>
            <button type="button" @onclick="LoadAsync" class="mt-2 font-bold text-sugbo-dark underline">Retry</button>
        </div>
    }
    else if (islands is null)
    {
        <p class="text-sm text-slate-500">Loading islands…</p>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            @foreach (var island in islands)
            {
                <IslandCard Island="island" />
            }
        </div>
    }
</div>

@code {
    private List<IslandDto>? islands;
    private string? error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        try { islands = await Catalog.GetIslandsAsync(featuredOnly: true); }
        catch (ApiException ex) { error = ex.Message; }
    }
}
